generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  name          String?
  username      String?  @unique
  avatar        String?
  role          String   @default("USER")
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  favorites     Favorite[]
  watchHistory  WatchHistory[]
  comments      Comment[]
  likes         Like[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  contents  Content[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  contents  ContentTag[]
}

model Content {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String
  thumbnail     String?
  videoUrl      String
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  tags          ContentTag[]
  comments      Comment[]
  likes         Like[]
  favorites     Favorite[]
  watchHistory  WatchHistory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ContentTag {
  id        String  @id @default(cuid())
  contentId String
  tagId     String
  content   Content @relation(fields: [contentId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@unique([contentId, tagId])
}

model Favorite {
  id        String  @id @default(cuid())
  userId    String
  contentId String
  user      User    @relation(fields: [userId], references: [id])
  content   Content @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId])
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  content   Content  @relation(fields: [contentId], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  content   Content  @relation(fields: [contentId], references: [id])
}

model Like {
  id        String  @id @default(cuid())
  userId    String
  contentId String
  user      User    @relation(fields: [userId], references: [id])
  content   Content @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId])
}
